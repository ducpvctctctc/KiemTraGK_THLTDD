
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHỈNH SỬA KHOẢN CHI"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên khoản chi"/>

        <EditText
            android:id="@+id/edtSuaTen_207"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập tên khoản chi"
            android:inputType="textCapSentences"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Số tiền"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/edtSuaTien_207"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập số tiền"
            android:inputType="numberDecimal"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ghi chú"
            android:layout_marginTop="16dp"/>

        <EditText
            android:id="@+id/edtSuaGhiChu_207"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập ghi chú"
            android:inputType="textMultiLine"
            android:minLines="2"/>

        <Button
            android:id="@+id/btnLuu_207"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lưu chỉnh sửa"
            android:layout_marginTop="24dp"/>

        <Button
            android:id="@+id/btnHuy_207"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hủy chỉnh sửa"/>

    </LinearLayout>
</ScrollView>
