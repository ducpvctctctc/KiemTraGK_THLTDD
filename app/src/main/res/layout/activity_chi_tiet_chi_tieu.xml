
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTenKhoanChi_207"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tên khoản chi:"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvSoTien_207"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Số tiền:"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvGhiChu_207"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ghi chú:"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvTrangThai_207"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Trạng thái: Chưa thanh toán"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnChinhSua_207"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chỉnh sửa khoản chi"
        android:layout_marginBottom="12dp"/>
    <Button
        android:id="@+id/btnQuayLai_207"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quay lại" />

</LinearLayout>
